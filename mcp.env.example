# Bu dosyayı tinnten-mpc-server/.env olarak kopyalayın ve gerçek secret'ları
# deployment secret manager üzerinden sağlayın. Bu örneğe secret yazmayın.

MCP_SECRET_MASTER_KEY=<32-byte-base64-key>

# Claude -> MCP resource token issuer. Bu servis kullanıcı login'ini aşağıdaki
# Keycloak realm'ine devreder ama servera özel audience tokenı üretir.
MCP_AUTH_ISSUER=https://auth.mcp.example.com
MCP_AUTH_JWKS_URL=https://auth.mcp.example.com/jwks.json

# tinnten-server tarafındaki MCP_RUNTIME_SERVICE_TOKEN ile aynı güçlü,
# rastgele değer olmalıdır. Yalnız runtime registry çözümlemesinde kullanılır.
TINNTEN_MCP_REGISTRY_TOKEN=<runtime-registry-service-token>

KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=tinnten
KEYCLOAK_CLIENT_ID=tinnten-realm
KEYCLOAK_CLIENT_SECRET=<keycloak-client-secret>
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/tinnten
KEYCLOAK_HTTP_TIMEOUT_MS=10000

# Dışarıdan HTTPS reverse proxy arkasında true kalmalı.
AUTH_COOKIE_SECURE=true
